# MyWay – Beispielwerte
#
# Die Web-App ist rein statisch und liest ihre Werte aus app/konfig.js.
# Diese Datei dient als Vorlage, sobald ein Build-Schritt oder ein Server
# dazukommt (z. B. Stripe-Zahlungen über eine Vercel-Function).

# Supabase – öffentlich, darf im Browser stehen
SUPABASE_URL=https://dein-projekt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase – geheim, nur serverseitig verwenden, nie committen
SUPABASE_SERVICE_ROLE_KEY=

# Stripe – kommt, sobald echt bezahlt wird
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
